# Copy to .env.local for development. Never commit real values.

# Public URL of the site, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. Locally this is the docker-compose database (pnpm db:up).
DATABASE_URL=postgres://laapata:laapata_dev_only@127.0.0.1:5433/laapata

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email for login codes (resend.com). Optional in development:
# without a key, codes are printed in the terminal instead of emailed.
RESEND_API_KEY=
EMAIL_FROM="LaapataPaisa <login@example.com>"

# Google sign-in (optional). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
